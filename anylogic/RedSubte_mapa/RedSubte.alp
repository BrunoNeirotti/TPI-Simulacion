							</Parameter>
							<Parameter>
								<Name>onExit</Name>
								<Value Class="CodeValue">
									<Code>// bajan los que llegaron a su estacion y se calcula la detencion (D13)
int bajan = 0;
for (Pasajero p : agent.carga.bajar(agent.indice)) {
    p.transbordando = p.etapa &lt; p.ruta.etapas.length - 1;
    if (p.transbordando) p.etapa++;
    aBordo.free(p);
    bajan++;
}
boolean ultima = agent.indice == agent.recorrido.largo() - 1;
if (agent.recienSale || ultima) {
    agent.dwell = 0;
} else {
    int suben = Math.min(andenDeFormacion(agent).esperando(), agent.carga.lugares());
    agent.dwell = modeloDetencion.segundos(agent.recorrido.detencion, agent.recorrido.linea,
            Datos.COCHES.get(agent.recorrido.linea), bajan, suben);
    sumaDetencion += agent.dwell;
    paradas++;
}</Code>
								</Value>
							</Parameter>
							<Parameter>
								<Name>onRemove</Name>
							</Parameter>
						</Parameters>

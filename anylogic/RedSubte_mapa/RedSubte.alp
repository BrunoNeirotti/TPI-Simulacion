							<Name><![CDATA[restoreEntityLocationOnExit]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[forceStatisticsCollection]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onEnter]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onAtExit]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onExit]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[// fin de la detencion: se pide el tramo siguiente (D15)
if (agent.indice < agent.recorrido.largo() - 1) {
    agent.espera = tramos.reservar(agent.recorrido, agent.indice, time()) - time();
} else {
    agent.espera = 0;
}]]></Code>
							</Value>
						</Parameter>

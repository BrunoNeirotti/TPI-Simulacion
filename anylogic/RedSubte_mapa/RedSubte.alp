					<Function AccessType="default" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType>double</ReturnType>
						<Id>1791270000120</Id>
						<Name>registrarSalida</Name>
						<X>2360</X>
						<Y>670</Y>
						<Label>
							<X>10</X>

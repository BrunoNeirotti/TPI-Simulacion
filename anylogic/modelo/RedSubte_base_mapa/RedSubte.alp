							<Parameter>
								<Name>delayTime</Name>
								<Value Class="CodeUnitValue">
									<Code>agent.dwell</Code>
									<Unit Class="TimeUnits">SECOND</Unit>
								</Value>
							</Parameter>
							<Parameter>
								<Name>capacity</Name>
							</Parameter>
							<Parameter>
								<Name>maximumCapacity</Name>
								<Value Class="CodeValue">
									<Code>true</Code>
								</Value>
							</Parameter>
							<Parameter>
								<Name>entityLocation</Name>
							</Parameter>
							<Parameter>
								<Name>pushProtocol</Name>
							</Parameter>
							<Parameter>
								<Name>restoreEntityLocationOnExit</Name>
							</Parameter>
							<Parameter>
								<Name>forceStatisticsCollection</Name>
							</Parameter>
							<Parameter>
								<Name>onEnter</Name>
							</Parameter>
							<Parameter>
								<Name>onAtExit</Name>
							</Parameter>
							<Parameter>
								<Name>onExit</Name>
								<Value Class="CodeValue">
									<Code>// fin de la detencion: se pide el tramo siguiente (D15)
if (agent.indice &lt; agent.recorrido.largo() - 1) {
    agent.espera = tramos.reservar(agent.recorrido, agent.indice, time()) - time();
} else {
    agent.espera = 0;
}</Code>
								</Value>
							</Parameter>

					<Body><![CDATA[// una formacion sale de una estacion: se anota cuanta gente lleva por el tramo que empieza
if (f.indice + 1 >= f.recorrido.largo()) return;
salidasTramo.computeIfAbsent(Datos.claveAnden(f.recorrido, f.indice), k -> new ArrayDeque<>())
        .addLast(new double[] {time(), f.carga.aBordo()});]]></Body>
				</Function>

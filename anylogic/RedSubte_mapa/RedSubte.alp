				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double[][]]]></ReturnType>
					<Id>1791270000115</Id>
					<Name><![CDATA[trazoDe]]></Name>
					<X>2060</X><Y>640</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[a]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[b]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[// polilinea de a hacia b: la del trazado oficial, invertida si hace falta, o recta
double[][] p = trazoTramo.get(a + ">" + b);
if (p != null) return p;
p = trazoTramo.get(b + ">" + a);
if (p != null) {
    double[][] q = new double[p.length][];
    for (int i = 0; i < p.length; i++) q[i] = p[p.length - 1 - i];
    return q;
}
return new double[][] {posNodo.get(a), posNodo.get(b)};]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double[]]]></ReturnType>
					<Id>1791270000116</Id>
					<Name><![CDATA[sobreTrazo]]></Name>
					<X>2210</X><Y>640</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[p]]></Name>
						<Type><![CDATA[double[][]]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[u]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[// {x, y, tx, ty}: punto a una fraccion u del trazo, corrido a la derecha de la marcha
double total = 0;
for (int i = 0; i + 1 < p.length; i++) total += Math.hypot(p[i + 1][0] - p[i][0], p[i + 1][1] - p[i][1]);
double s = Math.max(0, Math.min(1, u)) * total, acum = 0;
for (int i = 0; i + 1 < p.length; i++) {
    double dx = p[i + 1][0] - p[i][0], dy = p[i + 1][1] - p[i][1], l = Math.hypot(dx, dy);
    if (s <= acum + l || i + 2 == p.length) {
        double k = l == 0 ? 0 : Math.min(1, (s - acum) / l);
        double tx = l == 0 ? 1 : dx / l, ty = l == 0 ? 0 : dy / l;
        return new double[] {p[i][0] + dx * k - ty * 3.5, p[i][1] + dy * k + tx * 3.5, tx, ty};
    }
    acum += l;
}
return new double[] {p[0][0], p[0][1], 1, 0};]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1791270000117</Id>
					<Name><![CDATA[leerReferencia]]></Name>
					<X>2360</X><Y>640</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[informe]]></Name>
						<Type><![CDATA[java.nio.file.Path]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[prefijo]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[destino]]></Name>
						<Type><![CDATA[Map<String, double[]>]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[horaDestino]]></Name>
						<Type><![CDATA[double[][]]]></Type>
					</Parameter>
					<Body><![CDATA[// carga de referencia por tramo y hora (simulador de referencia, 100 replicas)
java.nio.file.Path pc = informe.resolve(prefijo + "_carga.csv");
if (java.nio.file.Files.exists(pc)) {
    Csv c = Csv.leer(pc);
    int cL = c.col("linea"), cS = c.col("direction_id"), cO = c.col("orden"), cH = c.col("hora"), cP = c.col("pasajeros_hora_media");
    for (String[] f : c.filas()) {
        double[] v = destino.computeIfAbsent(f[cL] + "/" + f[cS] + "/" + f[cO], k -> new double[24]);
        v[(int) Csv.num(f[cH])] = Csv.num(f[cP]);
    }
}
java.nio.file.Path ph = informe.resolve(prefijo + "_hora.csv");
if (java.nio.file.Files.exists(ph)) {
    Csv h = Csv.leer(ph);
    int cH = h.col("hora_ingreso"), cV = h.col("viaje_medio_s"), cE = h.col("espera_media_s");
    for (String[] f : h.filas()) {
        int hora = (int) Csv.num(f[cH]);
        if (hora >= 0 && hora < 24) horaDestino[hora] = new double[] {Csv.num(f[cV]), Csv.num(f[cE])};
    }
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1791270000118</Id>
					<Name><![CDATA[cargarMapa]]></Name>
					<X>2060</X><Y>670</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// al arrancar: posiciones, trazos, complejos, andenes por nodo y referencias para la comparacion
Set<String> nodosRed = new HashSet<>();
for (Recorrido r : datos.red.recorridos()) for (String n : r.nodos) nodosRed.add(n);
java.nio.file.Path dir = java.nio.file.Path.of(carpetaMapa());
Csv c = Csv.leer(dir.resolve("mapa_esquematico.csv"));
int cN = c.col("nodo_id"), cX = c.col("x"), cY = c.col("y"), cNom = c.col("nombre");
for (String[] f : c.filas()) {
    if (!nodosRed.contains(f[cN])) continue;
    posNodo.put(f[cN], new double[] {Csv.num(f[cX]), Csv.num(f[cY])});
    nombreNodo.put(f[cN], f[cNom]);
}
Csv t = Csv.leer(dir.resolve("mapa_tramos.csv"));
int tD = t.col("de_nodo"), tA = t.col("a_nodo"), tX = t.col("x"), tY = t.col("y");
Map<String, List<double[]>> acumulado = new LinkedHashMap<>();
for (String[] f : t.filas()) {
    if (!nodosRed.contains(f[tD]) || !nodosRed.contains(f[tA])) continue;
    acumulado.computeIfAbsent(f[tD] + ">" + f[tA], k -> new ArrayList<>())
            .add(new double[] {Csv.num(f[tX]), Csv.num(f[tY])});
}
for (Map.Entry<String, List<double[]>> e : acumulado.entrySet())
    trazoTramo.put(e.getKey(), e.getValue().toArray(new double[0][]));
// complejos: union-find sobre los transbordos
for (String n : posNodo.keySet()) padreNodo.put(n, n);
for (String k : datos.red.transbordos().keySet()) {
    String[] ab = k.split(">");
    if (posNodo.containsKey(ab[0]) && posNodo.containsKey(ab[1])) padreNodo.put(raiz(ab[0]), raiz(ab[1]));
}
for (int i = 0; i < 7; i++) andenesDeLinea.add(new ArrayList<>());
for (Recorrido r : datos.red.recorridos()) {
    for (int i = 0; i < r.largo(); i++) {
        Anden<Pasajero> an = andenes.get(Datos.claveAnden(r, i));
        andenesDeNodo.computeIfAbsent(r.nodos[i], k -> new ArrayList<>()).add(an);
        andenesDeLinea.get("ABCDEHF".indexOf(r.linea)).add(an);
    }
}
// referencia (simulador de referencia) para la comparacion sin la F / con la F
java.nio.file.Path informe = dir.resolve("informe");
String prefF = String.format("f%03d", intervaloF() > 0 ? intervaloF() : 100);
leerReferencia(informe, "base", refBase, refHoraBase);
if (!java.nio.file.Files.exists(informe.resolve(prefF + "_carga.csv"))) prefF = "f100";
leerReferencia(informe, prefF, refF, refHoraF);
for (int i = 0; i < 7; i++) filaLinea[i] = "";
for (int i = 0; i < 8; i++) { filaEstacion[i] = ""; filaComparacion[i] = ""; colorFilaEstacion[i] = GRIS_OSCURO; colorFilaComparacion[i] = GRIS_OSCURO; }
actualizarComparacion(5);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">

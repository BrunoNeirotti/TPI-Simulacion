						</Parameter>
						<Body>recorrido = r;
indice = desde;
recienSale = true;
activa = true;
enMarcha = false;
carga = new Carga&lt;Pasajero&gt;(r.largo(), capacidad);</Body>
					</Function>
					<Function AccessType="default" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType>double</ReturnType>
						<Id>1791270000132</Id>
						<Name>largoTren</Name>
						<X>40</X>
						<Y>180</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Body>// seis coches de 2,3 px en las lineas de seis; cinco en el resto
return recorrido == null ? 10 : Datos.COCHES.get(recorrido.linea) * 2.3;</Body>
					</Function>
					<Function AccessType="default" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType>Color</ReturnType>
						<Id>1791270000133</Id>
						<Name>colorTren</Name>
						<X>190</X>
						<Y>180</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Body>return carga == null || recorrido == null ? main.GRIS
        : main.colorOcupacion((double) carga.aBordo() / Datos.capacidad(recorrido.linea));</Body>
					</Function>
					<Function AccessType="default" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>

					</Parameter>
					<Body><![CDATA[if (soloLinea.isEmpty()) return true;
return r.etapas.length == 1 && r.etapas[0].recorrido.linea.equals(soloLinea);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[long]]></ReturnType>
					<Id>1791270000055</Id>
					<Name><![CDATA[noEntran]]></Name>
					<X>1490</X><Y>340</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[long n = 0;
for (Anden<Pasajero> a : andenes.values()) n += a.quedaronAbajo();
return n;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1791270000056</Id>
					<Name><![CDATA[noEntranPorLinea]]></Name>
					<X>1640</X><Y>340</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[Map<String, Long> m = new TreeMap<>();
for (Map.Entry<String, Anden<Pasajero>> e : andenes.entrySet())
    m.merge(e.getKey().split("/")[0], e.getValue().quedaronAbajo(), Long::sum);
return m.toString().replace(", ", ",");]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1791270000057</Id>
					<Name><![CDATA[picoLinea]]></Name>
					<X>1340</X><Y>370</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[linea]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[// mayor carga de la linea en un tramo y una hora (pasajeros por hora), como el simulador de control
double m = 0;
for (Map.Entry<String, double[]> e : cargaSaliente.entrySet())
    if (e.getKey().startsWith(linea + "/"))
        for (double v : e.getValue()) m = Math.max(m, v);
return m;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1791270000058</Id>
					<Name><![CDATA[picoLineaDonde]]></Name>
					<X>1490</X><Y>370</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[linea]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[// anden (linea/sentido/orden) y hora del pico de la linea
double m = -1;
String donde = "";
for (Map.Entry<String, double[]> e : cargaSaliente.entrySet())
    if (e.getKey().startsWith(linea + "/"))
        for (int h = 0; h < 24; h++)
            if (e.getValue()[h] > m) { m = e.getValue()[h]; donde = e.getKey() + "@" + h; }
return donde;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1791270000059</Id>
					<Name><![CDATA[resumen]]></Name>
					<X>1640</X><Y>370</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// una linea por corrida: ingresados;arribados;viaje_s;espera_s;ascensos_por_viaje;
// no_entran;max_vivos;max_formaciones;no_entran_por_linea;retenciones;s_retenidos;detencion_media;
// pico_c_pas_h;pico_f_pas_h;pico_c_donde
return ingresados + ";" + arribados + ";"
    + String.format(Locale.ROOT, "%.1f;%.1f;%.4f;", sumaTiempoViaje / arribados,
                    sumaEspera / arribados, (double) ascensos / ingresados)
    + noEntran() + ";" + maxVivos + ";" + maxFormaciones + ";" + noEntranPorLinea() + ";"
    + tramos.retenciones + ";" + Math.round(tramos.segundosRetenidos) + ";"
    + String.format(Locale.ROOT, "%.2f;%.0f;%.0f;", paradas == 0 ? 0 : sumaDetencion / paradas,
                    picoLinea("C"), picoLinea("F"))
    + picoLineaDonde("C");]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1791270000060</Id>
					<Name><![CDATA[lanzarFormacion]]></Name>
					<X>1340</X><Y>400</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[c]]></Name>
						<Type><![CDATA[Oferta.Cabecera]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[desde]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[Formacion f = formacionesLibres.poll();
if (f == null) error("Se agoto el pool de formaciones a las " + time());
maxFormaciones = Math.max(maxFormaciones, formaciones.size() - formacionesLibres.size());
f.iniciar(c.recorrido, desde, Datos.capacidad(c.linea));
enterFormacion.take(f);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Color]]></ReturnType>
					<Id>1791270000109</Id>
					<Name><![CDATA[colorLinea]]></Name>
					<X>2060</X><Y>580</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[l]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[switch (l) {
    case "A": return new Color(0, 167, 207);
    case "B": return new Color(237, 27, 45);
    case "C": return new Color(0, 61, 167);
    case "D": return new Color(32, 116, 99);
    case "E": return new Color(100, 40, 121);
    case "H": return new Color(228, 202, 37);
    default:  return new Color(245, 130, 32);   // F
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Color]]></ReturnType>
					<Id>1791270000110</Id>
					<Name><![CDATA[colorOcupacion]]></Name>
					<X>2210</X><Y>580</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[u]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[if (u < 0.3) return VERDE;
if (u < 0.7) return AMBAR;
return ROJO;]]></Body>

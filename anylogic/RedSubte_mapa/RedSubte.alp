					<Id>1791270000025</Id>
					<Name><![CDATA[iniciar]]></Name>
					<X>40</X><Y>150</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[r]]></Name>
						<Type><![CDATA[Recorrido]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[desde]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[capacidad]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[recorrido = r;
indice = desde;
recienSale = true;
activa = true;
enMarcha = false;
carga = new Carga<Pasajero>(r.largo(), capacidad);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1791270000132</Id>
					<Name><![CDATA[largoTren]]></Name>
					<X>40</X><Y>180</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// seis coches de 2,3 px en las lineas de seis; cinco en el resto
return recorrido == null ? 10 : Datos.COCHES.get(recorrido.linea) * 2.3;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Color]]></ReturnType>
					<Id>1791270000133</Id>
					<Name><![CDATA[colorTren]]></Name>
					<X>190</X><Y>180</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return carga == null || recorrido == null ? main.GRIS
        : main.colorOcupacion((double) carga.aBordo() / Datos.capacidad(recorrido.linea));]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1791270000134</Id>
					<Name><![CDATA[trenVisible]]></Name>
					<X>340</X><Y>180</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return activa && recorrido != null && main.verLinea(recorrido.linea);]]></Body>
				</Function>
			</Functions>


          <Event>
            <Id>1791500000357</Id>
            <Name>moverTrenes</Name>
            <X>50</X>
            <Y>3400</Y>
            <Label>
              <X>10</X>
              <Y>0</Y>
            </Label>
            <PublicFlag>false</PublicFlag>
            <PresentationFlag>true</PresentationFlag>
            <ShowLabel>true</ShowLabel>
            <Properties TriggerType="timeout" Mode="cyclic">
              <Timeout Class="CodeUnitValue">
                <Code>0.5</Code>
                <Unit Class="TimeUnits">SECOND</Unit>
              </Timeout>
              <Rate Class="CodeUnitValue">
                <Code>1</Code>
                <Unit Class="RateUnits">PER_SECOND</Unit>
              </Rate>
              <Id>1791500000356</Id>
              <OccurrenceAtTime>true</OccurrenceAtTime>
              <OccurrenceDate>1791273600000</OccurrenceDate>
              <OccurrenceTime Class="CodeUnitValue">
                <Code>0</Code>
                <Unit Class="TimeUnits">SECOND</Unit>
              </OccurrenceTime>
              <RecurrenceCode Class="CodeUnitValue">
                <Code>0.5</Code>
                <Unit Class="TimeUnits">SECOND</Unit>
              </RecurrenceCode>
              <Condition>false</Condition>
            </Properties>
            <Action>double per = 100;
double phN = ((time(SECOND) - 0) % per + per) % per;
double dN;
boolean paradoN = phN &lt; 30;
if (paradoN) dN = 0; else if (phN &lt; 30 + 40) { double s = phN - 30; dN = 0.5 * s * s; }
else { double s = per - phN; dN = -0.55 * s * s; }
boolean enVistaN = Math.abs(dN) &lt; 230;
trenN_c1.setX((42.85 + (1) * dN) * 10); trenN_c1.setVisible(enVistaN &amp;&amp; !paradoN); trenN_a1.setVisible(paradoN);
trenN_c2.setX((60.55 + (1) * dN) * 10); trenN_c2.setVisible(enVistaN &amp;&amp; !paradoN); trenN_a2.setVisible(paradoN);
trenN_c3.setX((78.25 + (1) * dN) * 10); trenN_c3.setVisible(enVistaN &amp;&amp; !paradoN); trenN_a3.setVisible(paradoN);
trenN_c4.setX((95.95 + (1) * dN) * 10); trenN_c4.setVisible(enVistaN &amp;&amp; !paradoN); trenN_a4.setVisible(paradoN);
trenN_c5.setX((113.65 + (1) * dN) * 10); trenN_c5.setVisible(enVistaN &amp;&amp; !paradoN); trenN_a5.setVisible(paradoN);
trenN_c6.setX((131.35 + (1) * dN) * 10); trenN_c6.setVisible(enVistaN &amp;&amp; !paradoN); trenN_a6.setVisible(paradoN);
double phS = ((time(SECOND) - 50) % per + per) % per;
double dS;
boolean paradoS = phS &lt; 30;
if (paradoS) dS = 0; else if (phS &lt; 30 + 40) { double s = phS - 30; dS = 0.5 * s * s; }
else { double s = per - phS; dS = -0.55 * s * s; }
boolean enVistaS = Math.abs(dS) &lt; 230;
trenS_c1.setX((42.85 + (-1) * dS) * 10); trenS_c1.setVisible(enVistaS &amp;&amp; !paradoS); trenS_a1.setVisible(paradoS);
trenS_c2.setX((60.55 + (-1) * dS) * 10); trenS_c2.setVisible(enVistaS &amp;&amp; !paradoS); trenS_a2.setVisible(paradoS);
trenS_c3.setX((78.25 + (-1) * dS) * 10); trenS_c3.setVisible(enVistaS &amp;&amp; !paradoS); trenS_a3.setVisible(paradoS);
trenS_c4.setX((95.95 + (-1) * dS) * 10); trenS_c4.setVisible(enVistaS &amp;&amp; !paradoS); trenS_a4.setVisible(paradoS);
trenS_c5.setX((113.65 + (-1) * dS) * 10); trenS_c5.setVisible(enVistaS &amp;&amp; !paradoS); trenS_a5.setVisible(paradoS);
trenS_c6.setX((131.35 + (-1) * dS) * 10); trenS_c6.setVisible(enVistaS &amp;&amp; !paradoS); trenS_a6.setVisible(paradoS);</Action>

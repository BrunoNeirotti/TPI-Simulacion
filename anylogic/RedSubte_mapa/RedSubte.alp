				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1791270000128</Id>
					<Name><![CDATA[actualizarBandas]]></Name>
					<X>2210</X><Y>760</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (modo == 0) return;
double t = time();
int hora = Math.max(0, Math.min(23, (int) (t / 3600)));
for (Recorrido r : datos.red.recorridos()) {
    if (!verLinea(r.linea)) continue;
    for (int i = 0; i + 1 < r.largo(); i++) {
        String clave = Datos.claveAnden(r, i);
        double ancho = 1;
        Color color = GRIS_CLARO;
        if (modo == 1) {
            ArrayDeque<double[]> cola = salidasTramo.get(clave);
            double pas = 0;
            int trenes = 0;
            if (cola != null) {
                while (!cola.isEmpty() && cola.peekFirst()[0] < t - 900) cola.pollFirst();   // ultimos 15 min
                for (double[] s : cola) { pas += s[1]; trenes++; }
            }
            double pasHora = pas * 3600 / 900;
            if (trenes > 0) {
                ancho = 1 + 9.0 * Math.min(1, pasHora / 12000);
                color = colorOcupacion(pas / (trenes * Datos.capacidad(r.linea)));
            }
        } else {
            double[] vb = refBase.get(clave), vf = refF.get(clave);
            double f = vf == null ? Double.NaN : vf[hora], base = vb == null ? Double.NaN : vb[hora];
            if (Double.isNaN(f)) {
                ancho = 1;
            } else if (Double.isNaN(base)) {
                ancho = 1 + 9.0 * Math.min(1, f / 12000);
                color = NARANJA;
            } else {
                double d = f - base;
                ancho = 1 + 9.0 * Math.min(1, Math.abs(d) / 6000);
                color = Math.abs(d) < 150 ? GRIS_CLARO : d < 0 ? AZUL : ROJO;
            }
        }
        anchoBanda.put(clave, ancho);
        colorBanda.put(clave, color);
    }
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1791270000129</Id>
					<Name><![CDATA[actualizarEstacion]]></Name>
					<X>2360</X><Y>760</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (nodoSeleccionado == null) return;
List<String> grupo = new ArrayList<>();
for (String n : posNodo.keySet()) if (raiz(n).equals(raiz(nodoSeleccionado))) grupo.add(n);
Collections.sort(grupo);
StringBuilder lineas = new StringBuilder();
for (String n : grupo) lineas.append(lineaDe(n));
tituloEstacion = nombreNodo.get(nodoSeleccionado) + "  [" + lineas + "]";
int fila = 0;
for (String n : grupo) {
    for (Anden<Pasajero> an : andenesDeNodo.get(n)) {
        if (an.indice + 1 >= an.recorrido.largo() || fila >= filaEstacion.length) continue;
        String hacia = nombreNodo.get(an.recorrido.nodos[an.recorrido.largo() - 1]);
        if (hacia.length() > 16) hacia = hacia.substring(0, 15) + ".";
        colorFilaEstacion[fila] = colorLinea(an.recorrido.linea).darker();
        filaEstacion[fila] = String.format("%s hacia %-16s esperan %4d   max. %4d   no entraron %d",
                an.recorrido.linea, hacia, an.esperando(), an.maximo(), an.quedaronAbajo());
        fila++;
    }
}
for (; fila < filaEstacion.length; fila++) filaEstacion[fila] = "";]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1791270000130</Id>
					<Name><![CDATA[actualizarComparacion]]></Name>
					<X>2060</X><Y>790</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[hora]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[hora = Math.max(0, Math.min(23, hora));
double[] maxBase = new double[7], maxF = new double[7];
for (Map.Entry<String, double[]> e : refBase.entrySet()) {
    int li = "ABCDEHF".indexOf(e.getKey().substring(0, 1));
    maxBase[li] = Math.max(maxBase[li], e.getValue()[hora]);
}
for (Map.Entry<String, double[]> e : refF.entrySet()) {
    int li = "ABCDEHF".indexOf(e.getKey().substring(0, 1));
    maxF[li] = Math.max(maxF[li], e.getValue()[hora]);
}
tituloComparacion = String.format("Sin la F  ->  con la F, de %d a %d h", hora, hora + 1);
for (int li = 0; li < 7; li++) {
    String L = "ABCDEHF".substring(li, li + 1);
    String fila;
    if (maxF[li] == 0 && maxBase[li] == 0) fila = L + "   sin datos";
    else if (maxBase[li] == 0) fila = L + "   --  ->  " + miles(maxF[li]) + "  (nueva)";
    else fila = String.format("%s   %s -> %s  (%+.0f %%)", L, miles(maxBase[li]), miles(maxF[li]),
            100 * (maxF[li] / maxBase[li] - 1));
    filaComparacion[li] = fila;
    colorFilaComparacion[li] = colorLinea(L).darker();
}
double[] vb = refHoraBase[hora], vf = refHoraF[hora];
filaComparacion[7] = vb == null || vf == null ? "" : String.format(
        "viaje medio %s -> %s s      espera media %s -> %s s", miles(vb[0]), miles(vf[0]), miles(vb[1]), miles(vf[1]));]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1791270000131</Id>
					<Name><![CDATA[actualizarMapa]]></Name>
					<X>2210</X><Y>790</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// lo llama el evento ciclico `animar`: mueve las formaciones y recalcula lo que muestran las figuras
double t = time();
for (Formacion f : formaciones) {
    if (!f.activa) continue;
    double[] q;
    if (f.enMarcha && f.indice + 1 < f.recorrido.largo()) {
        double u = (t - f.tSalida) / f.recorrido.tramo[f.indice];
        q = sobreTrazo(trazoDe(f.recorrido.nodos[f.indice], f.recorrido.nodos[f.indice + 1]), u);
    } else if (f.indice + 1 < f.recorrido.largo()) {
        q = sobreTrazo(trazoDe(f.recorrido.nodos[f.indice], f.recorrido.nodos[f.indice + 1]), 0);
    } else {
        q = sobreTrazo(trazoDe(f.recorrido.nodos[f.indice - 1], f.recorrido.nodos[f.indice]), 1);
    }
    f.setXY(q[0], q[1]);
    f.setRotation(Math.atan2(q[3], q[2]));
}
if (cuadroMapa++ % 8 != 0) return;
for (Map.Entry<String, List<Anden<Pasajero>>> e : andenesDeNodo.entrySet()) {
    int n = 0;
    for (Anden<Pasajero> an : e.getValue()) n += an.esperando();
    radioEstacion.put(e.getKey(), 4 + Math.min(10, Math.sqrt(n) * 0.35));
    colorEstacion.put(e.getKey(), n < 30 ? Color.WHITE : n < 150 ? ESPERAN_MEDIO : ESPERAN_MUCHO);
}
int enSistema = enAnden.size() + aBordo.size() + caminata.size();
int hora = (int) (t / 3600);
relojTexto = String.format("%02d:%02d", hora, (int) (t % 3600 / 60));
cuentaTexto = "en el sistema: " + miles(enSistema);
formacionesTexto = "formaciones en circulacion: " + (formaciones.size() - formacionesLibres.size());
promediosTexto = arribados == 0 ? "viaje medio: --   espera media: --"
        : "viaje medio: " + miles(sumaTiempoViaje / arribados) + " s   espera media: "
          + miles(sumaEspera / arribados) + " s   (" + miles(arribados) + " viajes)";
int[] trenes = new int[7];
double[] sumaOc = new double[7], maxOc = new double[7];
for (Formacion f : formaciones) {
    if (!f.activa) continue;
    int li = "ABCDEHF".indexOf(f.recorrido.linea);
    double u = (double) f.carga.aBordo() / Datos.capacidad(f.recorrido.linea);
    trenes[li]++;
    sumaOc[li] += u;
    maxOc[li] = Math.max(maxOc[li], u);
}
for (int i = 0; i < 7; i++) {
    int esperan = 0;
    for (Anden<Pasajero> an : andenesDeLinea.get(i)) esperan += an.esperando();
    filaLinea[i] = String.format("%2d trenes   ocup. %3.0f %% (max. %3.0f %%)   esperan %s",
            trenes[i], trenes[i] == 0 ? 0 : 100 * sumaOc[i] / trenes[i], 100 * maxOc[i], miles(esperan));
}
if (hora != horaComparacion) {
    horaComparacion = hora;
    actualizarComparacion(hora);
}
actualizarBandas();
actualizarEstacion();]]></Body>
				</Function>
			</Functions>


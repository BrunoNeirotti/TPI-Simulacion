						<Body>// una formacion sale de una estacion: se anota cuanta gente lleva por el tramo que empieza
if (f.indice + 1 &gt;= f.recorrido.largo()) return;
salidasTramo.computeIfAbsent(Datos.claveAnden(f.recorrido, f.indice), k -&gt; new ArrayDeque&lt;&gt;())
        .addLast(new double[] {time(), f.carga.aBordo()});</Body>

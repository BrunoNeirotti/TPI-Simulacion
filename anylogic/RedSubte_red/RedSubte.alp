						<Parameters>
							<Parameter>
								<Name>type</Name>
							</Parameter>
							<Parameter>
								<Name>delayTime</Name>
								<Value Class="CodeUnitValue">
									<Code>0</Code>
									<Unit Class="TimeUnits">SECOND</Unit>
								</Value>
							</Parameter>
							<Parameter>
								<Name>capacity</Name>
							</Parameter>
							<Parameter>
								<Name>maximumCapacity</Name>
								<Value Class="CodeValue">
									<Code>true</Code>
								</Value>
							</Parameter>
							<Parameter>
								<Name>entityLocation</Name>
							</Parameter>
							<Parameter>
								<Name>pushProtocol</Name>
							</Parameter>
							<Parameter>
								<Name>restoreEntityLocationOnExit</Name>

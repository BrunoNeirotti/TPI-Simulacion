				<AdditionalClassCode>Datos datos;
Detencion modeloDetencion;   // D13: detencion endogena
Tramos tramos;               // D15: separacion minima por tramo
Map&lt;String, Anden&lt;Pasajero&gt;&gt; andenes;
Random rng;

// contadores de verificacion
long ingresados, arribados, descartados, ascensos, maxVivos, maxFormaciones;
double sumaTiempoViaje, sumaEspera, sumaDetencion;
long paradas;

Anden&lt;Pasajero&gt; andenDe(Pasajero p) {
    return andenes.get(Datos.claveAnden(p.etapaActual()));
}

Anden&lt;Pasajero&gt; andenDe(Formacion f) {
    return andenes.get(Datos.claveAnden(f.recorrido, f.indice));
}

boolean correEnEstaCorrida(Ruta r) {
    if (soloLinea.isEmpty()) return true;
    return r.etapas.length == 1 &amp;&amp; r.etapas[0].recorrido.linea.equals(soloLinea);
}

long noEntran() {
    long n = 0;
    for (Anden&lt;Pasajero&gt; a : andenes.values()) n += a.quedaronAbajo();
    return n;
}

String noEntranPorLinea() {
    Map&lt;String, Long&gt; m = new TreeMap&lt;&gt;();
    for (Map.Entry&lt;String, Anden&lt;Pasajero&gt;&gt; e : andenes.entrySet())
        m.merge(e.getKey().split("/")[0], e.getValue().quedaronAbajo(), Long::sum);
    return m.toString().replace(", ", ",");
}

// una linea por corrida: ingresados;arribados;viaje_s;espera_s;ascensos_por_viaje;
// no_entran;max_vivos;max_formaciones
String resumen() {
    return ingresados + ";" + arribados + ";"
        + String.format(Locale.ROOT, "%.1f;%.1f;%.4f;", sumaTiempoViaje / arribados,
                        sumaEspera / arribados, (double) ascensos / ingresados)
        + noEntran() + ";" + maxVivos + ";" + maxFormaciones + ";" + noEntranPorLinea() + ";"
        + tramos.retenciones + ";" + Math.round(tramos.segundosRetenidos) + ";"
        + String.format(Locale.ROOT, "%.2f", paradas == 0 ? 0 : sumaDetencion / paradas);
}

void lanzarFormacion(Oferta.Cabecera c, int desde) {
    Formacion f = formacionesLibres.poll();
    if (f == null) error("Se agoto el pool de formaciones a las " + time());
    maxFormaciones = Math.max(maxFormaciones, formaciones.size() - formacionesLibres.size());
    f.iniciar(c.recorrido, desde, Datos.capacidad(c.linea));
    enterFormacion.take(f);
}
// ---- capa visual: mapa esquematico oficial, formaciones, andenes, panel y filtro por linea;
// ---- ficha de la estacion al hacer clic, carga por tramo en vivo y comparacion con la red actual
static final String LINEAS_MAPA = "ABCDEHF";
static final double VENTANA_CARGA_S = 900;     // "carga ahora": ultimos 15 min, llevados a pas./h
static final double LADO_MAPA = 3.5;           // separacion de los dos sentidos, en pixeles
static final double LADO_BANDA = 5.0;          // eje de la banda de carga, a la derecha de la marcha
static final double ANCHO_BANDA_MAX = 9.0;
static final double ESCALA_BANDA = 12000;      // pas./h que llenan el ancho maximo de la banda
static final double ESCALA_DIFERENCIA = 6000;  // diferencia (pas./h) que llena el ancho maximo
static final double X_PANEL = 16, ANCHO_PANEL = 296;
static final double X_GRAF = 16, Y_GRAF = 606, ALTO_GRAF = 50, PASO_GRAF = 1.2;
static final double Y_LEYENDA = 676;           // franja bajo el mapa
static final double ANCHO_MARCO = 1200;
static final String REF_F_SIN_INTERVALO = "f100";   // referencia con F que usa el modelo de la red actual

Map&lt;String, double[]&gt; posNodo = new HashMap&lt;&gt;();
Map&lt;String, String&gt; nombreNodo = new HashMap&lt;&gt;();
Map&lt;String, double[][]&gt; trazoTramo = new HashMap&lt;&gt;();     // "de&gt;a" -&gt; polilinea
Map&lt;String, List&lt;com.anylogic.engine.presentation.Shape&gt;&gt; deLinea = new HashMap&lt;&gt;();
Map&lt;String, ShapeOval&gt; marcaNodo = new HashMap&lt;&gt;();
Map&lt;String, List&lt;Anden&lt;Pasajero&gt;&gt;&gt; andenesDeNodo = new HashMap&lt;&gt;();
List&lt;List&lt;Anden&lt;Pasajero&gt;&gt;&gt; andenesDeLinea = new ArrayList&lt;&gt;();
Map&lt;String, String&gt; padreNodo = new HashMap&lt;&gt;();          // union-find de los complejos
boolean[] lineaVisible = {true, true, true, true, true, true, true};
ShapeLine[] trenBorde = new ShapeLine[150], trenCuerpo = new ShapeLine[150];
ShapeOval[] trenProa = new ShapeOval[150];
List&lt;com.anylogic.engine.presentation.Shape&gt; trazoLineas = new ArrayList&lt;&gt;();
List&lt;String&gt; lineaDeTrazo = new ArrayList&lt;&gt;();
List&lt;com.anylogic.engine.presentation.Shape&gt; etiquetasExtra = new ArrayList&lt;&gt;();
List&lt;List&lt;com.anylogic.engine.presentation.Shape&gt;&gt; leyendaModo = new ArrayList&lt;&gt;();
ShapeText relojMapa, cuentaMapa, formacionesMapa, promediosMapa, tituloEstacion, tituloComparacion;
ShapeText[] filaLinea = new ShapeText[7], filaEstacion = new ShapeText[8], filaComparacion = new ShapeText[8];
ShapeLine[] barra = new ShapeLine[240];
ShapeOval anillo;
String nodoSeleccionado = null;
int modo = 0;                                  // 0 lineas, 1 carga ahora, 2 con la F frente a la red actual
int cuadroMapa, ultimaMuestra = -1;
Set&lt;String&gt; nodosRed = new HashSet&lt;&gt;();

// bandas de carga: una por tramo y sentido
class Banda {
    String linea, clave;                       // clave = linea/sentido/orden, la del anden de salida
    ShapePolyLine forma;
}
List&lt;Banda&gt; bandas = new ArrayList&lt;&gt;();
Map&lt;String, ArrayDeque&lt;double[]&gt;&gt; salidasTramo = new HashMap&lt;&gt;();   // clave -&gt; {t, a bordo}
Map&lt;String, double[]&gt; refBase = new HashMap&lt;&gt;(), refF = new HashMap&lt;&gt;();   // clave -&gt; pas./h por hora
double[][] refHoraBase = new double[24][], refHoraF = new double[24][];    // hora -&gt; {viaje, espera}
String escenario = "", intervaloF = "";

static java.awt.Color colorLinea(String l) {
    switch (l) {
        case "A": return new java.awt.Color(24, 190, 230);
        case "B": return new java.awt.Color(230, 28, 0);
        case "C": return new java.awt.Color(0, 114, 187);
        case "D": return new java.awt.Color(0, 160, 60);
        case "E": return new java.awt.Color(109, 32, 120);
        case "H": return new java.awt.Color(240, 200, 0);
        default:  return new java.awt.Color(245, 130, 32);   // F
    }
}

static final java.awt.Color VERDE = new java.awt.Color(46, 160, 67), AMBAR = new java.awt.Color(240, 173, 0),
        ROJO = new java.awt.Color(220, 50, 47), AZUL = new java.awt.Color(40, 100, 200),
        GRIS = new java.awt.Color(120, 120, 120), GRIS_OSCURO = new java.awt.Color(60, 60, 60),
        NARANJA = new java.awt.Color(245, 130, 32), GRIS_CLARO = new java.awt.Color(200, 200, 200);

static java.awt.Color colorOcupacion(double u) {
    if (u &lt; 0.3) return VERDE;
    if (u &lt; 0.7) return AMBAR;
    return ROJO;
}

static String miles(double v) {
    return String.format(Locale.ROOT, "%,.0f", v).replace(',', '.');
}

/** Polilinea de a hacia b: la del trazado oficial, invertida si hace falta, o recta. */
double[][] trazoDe(String a, String b) {
    double[][] p = trazoTramo.get(a + "&gt;" + b);
    if (p != null) return p;
    p = trazoTramo.get(b + "&gt;" + a);
    if (p != null) {
        double[][] q = new double[p.length][];
        for (int i = 0; i &lt; p.length; i++) q[i] = p[p.length - 1 - i];
        return q;
    }
    return new double[][] {posNodo.get(a), posNodo.get(b)};
}

/** {x, y, tx, ty}: punto a una fraccion u del trazo, corrido a la derecha de la marcha. */
double[] sobreTrazo(double[][] p, double u) {
    double total = 0;
    for (int i = 0; i + 1 &lt; p.length; i++) total += Math.hypot(p[i + 1][0] - p[i][0], p[i + 1][1] - p[i][1]);
    double s = Math.max(0, Math.min(1, u)) * total, acum = 0;
    for (int i = 0; i + 1 &lt; p.length; i++) {
        double dx = p[i + 1][0] - p[i][0], dy = p[i + 1][1] - p[i][1], l = Math.hypot(dx, dy);
        if (s &lt;= acum + l || i + 2 == p.length) {
            double k = l == 0 ? 0 : Math.min(1, (s - acum) / l);
            double tx = l == 0 ? 1 : dx / l, ty = l == 0 ? 0 : dy / l;
            // a la derecha del sentido de marcha (en pantalla, con y hacia abajo)
            return new double[] {p[i][0] + dx * k - ty * LADO_MAPA, p[i][1] + dy * k + tx * LADO_MAPA, tx, ty};
        }
        acum += l;
    }
    return new double[] {p[0][0], p[0][1], 1, 0};
}

/** La polilinea corrida d pixeles a la derecha de la marcha, con los vertices en la bisectriz. */
double[][] desplazar(double[][] p, double d) {
    int n = p.length;
    double[][] q = new double[n][];
    double[][] nrm = new double[n - 1][];
    for (int i = 0; i + 1 &lt; n; i++) {
        double dx = p[i + 1][0] - p[i][0], dy = p[i + 1][1] - p[i][1], l = Math.hypot(dx, dy);
        nrm[i] = l == 0 ? new double[] {0, 0} : new double[] {-dy / l, dx / l};
    }
    for (int i = 0; i &lt; n; i++) {
        double nx, ny;
        if (i == 0) { nx = nrm[0][0]; ny = nrm[0][1]; }
        else if (i == n - 1) { nx = nrm[n - 2][0]; ny = nrm[n - 2][1]; }
        else {
            nx = nrm[i - 1][0] + nrm[i][0];
            ny = nrm[i - 1][1] + nrm[i][1];
            double l = Math.hypot(nx, ny);
            if (l &lt; 1e-6) { nx = nrm[i][0]; ny = nrm[i][1]; }
            else {
                nx /= l; ny /= l;
                double cos = nx * nrm[i][0] + ny * nrm[i][1];   // alargar en la bisectriz, con tope
                double k = Math.min(2.0, 1 / Math.max(cos, 1e-3));
                nx *= k; ny *= k;
            }
        }
        q[i] = new double[] {p[i][0] + nx * d, p[i][1] + ny * d};
    }
    return q;
}

void agregarDeLinea(String linea, com.anylogic.engine.presentation.Shape s) {
    deLinea.computeIfAbsent(linea, k -&gt; new ArrayList&lt;&gt;()).add(s);
}

String raiz(String x) {
    while (!padreNodo.get(x).equals(x)) x = padreNodo.get(x);
    return x;
}

String lineaDe(String nodo) {
    return nodo.substring(5, 6);
}

/** Etiqueta con halo blanco, en el primer lugar libre; false si no hay. */
boolean etiquetar(String texto, double px, double py, int tam, boolean negrita, java.awt.Color color,
                  List&lt;double[]&gt; ocupados, String linea, List&lt;com.anylogic.engine.presentation.Shape&gt; destino) {
    double w = texto.length() * (tam * 0.62) + 6, h = tam + 6;
    double[][] cand = {{8, -2, 0}, {8, -h - 2, 0}, {-8, -2, 1}, {-8, -h - 2, 1}, {0, 8, 2}, {0, -h - 8, 2},
                       {12, 8, 0}, {-12, 8, 1}, {12, -h - 10, 0}, {-12, -h - 10, 1}};
    for (double[] c : cand) {
        double x0 = c[2] == 0 ? px + c[0] : c[2] == 1 ? px + c[0] - w : px - w / 2;
        double y0 = py + c[1];
        boolean libre = x0 &gt; 322 &amp;&amp; x0 + w &lt; ANCHO_MARCO - 4 &amp;&amp; y0 &gt; 2 &amp;&amp; y0 + h &lt; Y_LEYENDA - 6;
        for (double[] o : ocupados) {
            if (x0 &lt; o[0] + o[2] &amp;&amp; x0 + w &gt; o[0] &amp;&amp; y0 &lt; o[1] + o[3] &amp;&amp; y0 + h &gt; o[1]) { libre = false; break; }
        }
        if (!libre) continue;
        ocupados.add(new double[] {x0, y0, w, h});
        // halo blanco: cuatro copias desplazadas, para que se lea sobre las lineas
        for (int k = 0; k &lt; 5; k++) {
            ShapeText t = new ShapeText();
            double dx = k == 4 ? 0 : (k % 2 == 0 ? -1.2 : 1.2), dy = k == 4 ? 0 : (k &lt; 2 ? -1.2 : 1.2);
            t.setPos(x0 + 3 + dx, y0 + 2 + dy);
            t.setText(texto);
            t.setColor(k == 4 ? color : java.awt.Color.WHITE);
            t.setFont(new java.awt.Font("SansSerif", negrita ? java.awt.Font.BOLD : java.awt.Font.PLAIN, tam));
            presentation.add(t);
            if (linea != null) agregarDeLinea(linea, t);
            if (destino != null) destino.add(t);
        }
        return true;
    }
    return false;
}

void alternarLinea(String linea, boolean visible) {
    lineaVisible[LINEAS_MAPA.indexOf(linea)] = visible;
    List&lt;com.anylogic.engine.presentation.Shape&gt; l = deLinea.get(linea);
    if (l != null) for (com.anylogic.engine.presentation.Shape s : l) s.setVisible(visible);
    aplicarModo();
}

ShapeText texto(double x, double y, int tam, boolean negrita, java.awt.Color color) {
    ShapeText t = new ShapeText();
    t.setPos(x, y);
    t.setFont(new java.awt.Font("SansSerif", negrita ? java.awt.Font.BOLD : java.awt.Font.PLAIN, tam));
    t.setColor(color);
    presentation.add(t);
    return t;
}

ShapeText texto(double x, double y, int tam, boolean negrita, java.awt.Color color, String contenido) {
    ShapeText t = texto(x, y, tam, negrita, color);
    t.setText(contenido);
    return t;
}

void separador(double y) {
    ShapeLine l = new ShapeLine();
    l.setPos(X_PANEL, y);
    l.setDx(ANCHO_PANEL);
    l.setDy(0);
    l.setColor(GRIS_CLARO);
    l.setLineWidth(1);
    presentation.add(l);
}

/** Muestra de color con texto, para las leyendas; devuelve el x donde termina. */
double muestra(double x, double y, java.awt.Color color, boolean relleno, String t,
               List&lt;com.anylogic.engine.presentation.Shape&gt; destino) {
    ShapeRectangle r = new ShapeRectangle();
    r.setPos(x, y + 1);
    r.setWidth(14);
    r.setHeight(10);
    r.setFillColor(relleno ? color : java.awt.Color.WHITE);
    r.setLineColor(relleno ? color : color);
    r.setLineWidth(relleno ? 0 : 2);
    presentation.add(r);
    destino.add(r);
    ShapeText s = texto(x + 18, y, 11, false, GRIS_OSCURO, t);
    destino.add(s);
    return x + 18 + t.length() * 6.4 + 14;
}

void aplicarModo() {
    for (int i = 0; i &lt; trazoLineas.size(); i++)
        trazoLineas.get(i).setVisible(modo == 0 &amp;&amp; lineaVisible[LINEAS_MAPA.indexOf(lineaDeTrazo.get(i))]);
    for (Banda b : bandas) b.forma.setVisible(modo != 0 &amp;&amp; lineaVisible[LINEAS_MAPA.indexOf(b.linea)]);
    for (int m = 0; m &lt; leyendaModo.size(); m++)
        for (com.anylogic.engine.presentation.Shape s : leyendaModo.get(m)) s.setVisible(m == modo);
    actualizarBandas();
}

Csv leerSiExiste(java.nio.file.Path p) {
    return java.nio.file.Files.exists(p) ? Csv.leer(p) : null;
}

/** Carga de referencia por tramo y hora (simulador de referencia, 10 replicas). */
void leerReferencia(java.nio.file.Path informe, String prefijo, Map&lt;String, double[]&gt; destino, double[][] horaDestino) {
    Csv c = leerSiExiste(informe.resolve(prefijo + "_carga.csv"));
    if (c != null) {
        int cL = c.col("linea"), cS = c.col("direction_id"), cO = c.col("orden"), cH = c.col("hora"), cP = c.col("pasajeros_hora_media");
        for (String[] f : c.filas()) {
            double[] v = destino.computeIfAbsent(f[cL] + "/" + f[cS] + "/" + f[cO], k -&gt; new double[24]);
            v[(int) Csv.num(f[cH])] = Csv.num(f[cP]);
        }
    }
    Csv h = leerSiExiste(informe.resolve(prefijo + "_hora.csv"));
    if (h != null) {
        int cH = h.col("hora_ingreso"), cV = h.col("viaje_medio_s"), cE = h.col("espera_media_s");
        for (String[] f : h.filas()) {
            int hora = (int) Csv.num(f[cH]);
            if (hora &gt;= 0 &amp;&amp; hora &lt; 24) horaDestino[hora] = new double[] {Csv.num(f[cV]), Csv.num(f[cE])};
        }
    }
}

void registrarSalida(Formacion f) {
    if (f.indice + 1 &gt;= f.recorrido.largo()) return;
    salidasTramo.computeIfAbsent(Datos.claveAnden(f.recorrido, f.indice), k -&gt; new ArrayDeque&lt;&gt;())
            .addLast(new double[] {time(), f.carga.aBordo()});
}

void seleccionar(String nodo) {
    nodoSeleccionado = nodo;
    double[] p = posNodo.get(nodo);
    anillo.setPos(p[0], p[1]);
    anillo.setVisible(true);
    actualizarEstacion();
}

void dibujarMapa() {
    for (Recorrido r : datos.red.recorridos()) for (String n : r.nodos) nodosRed.add(n);
    java.nio.file.Path dir = java.nio.file.Path.of(carpetaMapa.isEmpty() ? carpetaDatos : carpetaMapa);
    Csv c = Csv.leer(dir.resolve("mapa_esquematico.csv"));
    int cN = c.col("nodo_id"), cX = c.col("x"), cY = c.col("y"), cNom = c.col("nombre");
    for (String[] f : c.filas()) {
        if (!nodosRed.contains(f[cN])) continue;
        posNodo.put(f[cN], new double[] {Csv.num(f[cX]), Csv.num(f[cY])});
        nombreNodo.put(f[cN], f[cNom]);
    }
    Csv t = Csv.leer(dir.resolve("mapa_tramos.csv"));
    int tD = t.col("de_nodo"), tA = t.col("a_nodo"), tX = t.col("x"), tY = t.col("y");
    Map&lt;String, List&lt;double[]&gt;&gt; acumulado = new LinkedHashMap&lt;&gt;();
    for (String[] f : t.filas()) {
        if (!nodosRed.contains(f[tD]) || !nodosRed.contains(f[tA])) continue;
        acumulado.computeIfAbsent(f[tD] + "&gt;" + f[tA], k -&gt; new ArrayList&lt;&gt;())
                .add(new double[] {Csv.num(f[tX]), Csv.num(f[tY])});
    }
    for (Map.Entry&lt;String, List&lt;double[]&gt;&gt; e : acumulado.entrySet()) {
        trazoTramo.put(e.getKey(), e.getValue().toArray(new double[0][]));
    }

    // escenario y referencia (simulador de referencia) para la comparacion
    java.util.regex.Matcher m = java.util.regex.Pattern.compile("I(\\d{3})").matcher(carpetaDatos);
    boolean conF = false;
    for (Recorrido r : datos.red.recorridos()) if (r.linea.equals("F")) conF = true;
    if (conF &amp;&amp; m.find()) {
        intervaloF = String.valueOf(Integer.parseInt(m.group(1)));
        escenario = "Escenario: con la Linea F, intervalo de " + intervaloF + " s";
    } else {
        escenario = "Escenario: red actual, sin la Linea F";
    }
    String prefF = conF &amp;&amp; !intervaloF.isEmpty() ? String.format("f%03d", Integer.parseInt(intervaloF)) : REF_F_SIN_INTERVALO;
    java.nio.file.Path informe = dir.resolve("informe");
    if (!java.nio.file.Files.isDirectory(informe)) informe = dir.resolve("..").resolve("informe");
    leerReferencia(informe, "base", refBase, refHoraBase);
    if (!java.nio.file.Files.exists(informe.resolve(prefF + "_carga.csv"))) prefF = REF_F_SIN_INTERVALO;
    leerReferencia(informe, prefF, refF, refHoraF);

    // complejos: union-find sobre los transbordos
    for (String n : posNodo.keySet()) padreNodo.put(n, n);
    Set&lt;String&gt; unidos = new HashSet&lt;&gt;();
    List&lt;String[]&gt; pasillos = new ArrayList&lt;&gt;();
    for (String k : datos.red.transbordos().keySet()) {
        String[] ab = k.split("&gt;");
        if (!posNodo.containsKey(ab[0]) || !posNodo.containsKey(ab[1])) continue;
        padreNodo.put(raiz(ab[0]), raiz(ab[1]));
        String clave = ab[0].compareTo(ab[1]) &lt; 0 ? k : ab[1] + "&gt;" + ab[0];
        if (unidos.add(clave)) pasillos.add(ab);
    }
    // combinaciones: pasillo (borde oscuro y centro blanco) entre los nodos que se conectan a pie
    for (String[] ab : pasillos) {
        double[] pa = posNodo.get(ab[0]), pb = posNodo.get(ab[1]);
        for (int cap = 0; cap &lt; 2; cap++) {
            ShapeLine l = new ShapeLine();
            l.setPos(pa[0], pa[1]);
            l.setDx(pb[0] - pa[0]);
            l.setDy(pb[1] - pa[1]);
            l.setColor(cap == 0 ? GRIS_OSCURO : java.awt.Color.WHITE);
            l.setLineWidth(cap == 0 ? 9 : 5);
            presentation.add(l);
        }
    }

    // bandas de carga por tramo y sentido (debajo del trazado; se ven en los modos 1 y 2)
    for (Recorrido r : datos.red.recorridos()) {
        for (int i = 0; i + 1 &lt; r.largo(); i++) {
            double[][] p = desplazar(trazoDe(r.nodos[i], r.nodos[i + 1]), LADO_BANDA);
            double[] dx = new double[p.length], dy = new double[p.length];
            for (int j = 0; j &lt; p.length; j++) { dx[j] = p[j][0] - p[0][0]; dy[j] = p[j][1] - p[0][1]; }
            Banda b = new Banda();
            b.linea = r.linea;
            b.clave = Datos.claveAnden(r, i);
            b.forma = new ShapePolyLine(true, p[0][0], p[0][1], GRIS_CLARO, null, p.length, dx, dy, false, 1,
                    LineStyle.LINE_STYLE_SOLID);
            b.forma.setVisible(false);
            presentation.add(b.forma);
            bandas.add(b);
        }
    }

    // trazado oficial por tramos: primero la F (abajo), despues las demas
    for (int pasada = 0; pasada &lt; 2; pasada++) {
        for (Map.Entry&lt;String, double[][]&gt; e : trazoTramo.entrySet()) {
            String linea = e.getKey().substring(5, 6);
            if (linea.equals("F") != (pasada == 0)) continue;
            double[][] p = e.getValue();
            // en los modos de carga el trazado queda como guia fina y gris (debajo del color)
            double[] dx = new double[p.length], dy = new double[p.length];
            for (int j = 0; j &lt; p.length; j++) { dx[j] = p[j][0] - p[0][0]; dy[j] = p[j][1] - p[0][1]; }
            ShapePolyLine guia = new ShapePolyLine(false, p[0][0], p[0][1], GRIS_CLARO, null, p.length, dx, dy, false, 1,
                    LineStyle.LINE_STYLE_SOLID);
            presentation.add(guia);
            agregarDeLinea(linea, guia);
            for (int i = 0; i + 1 &lt; p.length; i++) {
                ShapeLine l = new ShapeLine();
                l.setPos(p[i][0], p[i][1]);
                l.setDx(p[i + 1][0] - p[i][0]);
                l.setDy(p[i + 1][1] - p[i][1]);
                l.setColor(colorLinea(linea));
                l.setLineWidth(linea.equals("F") ? 9 : 4);
                presentation.add(l);
                agregarDeLinea(linea, l);
                trazoLineas.add(l);
                lineaDeTrazo.add(linea);
            }
        }
    }

    // estaciones: un ovalo por nodo, con clic; crece y se enrojece con los que esperan
    for (Map.Entry&lt;String, double[]&gt; e : posNodo.entrySet()) {
        final String id = e.getKey();
        ShapeOval o = new ShapeOval(true, e.getValue()[0], e.getValue()[1], 0, colorLinea(lineaDe(id)),
                java.awt.Color.WHITE, 4, 4, 2, LineStyle.LINE_STYLE_SOLID) {
            @Override
            public boolean onClick(double cx, double cy) {
                seleccionar(id);
                return true;
            }
        };
        presentation.add(o);
        marcaNodo.put(id, o);
        agregarDeLinea(lineaDe(id), o);
    }
    anillo = new ShapeOval();
    anillo.setRadius(13);
    anillo.setFillColor(null);
    anillo.setLineColor(GRIS_OSCURO);
    anillo.setLineWidth(2.5);
    anillo.setVisible(false);
    presentation.add(anillo);

    // etiquetas: la F primero, despues las combinaciones, despues las cabeceras; el resto, a pedido
    List&lt;double[]&gt; ocupados = new ArrayList&lt;&gt;();
    Set&lt;String&gt; etiquetados = new HashSet&lt;&gt;();
    for (int n = 1; n &lt;= 12; n++) {
        String id = String.format("LineaF:F%02d", n);
        if (!posNodo.containsKey(id)) continue;
        if (etiquetar(nombreNodo.get(id), posNodo.get(id)[0], posNodo.get(id)[1], 12, true,
                new java.awt.Color(150, 70, 0), ocupados, "F", null)) etiquetados.add(raiz(id));
    }
    Map&lt;String, List&lt;String&gt;&gt; complejos = new TreeMap&lt;&gt;();
    for (String n : posNodo.keySet()) complejos.computeIfAbsent(raiz(n), k -&gt; new ArrayList&lt;&gt;()).add(n);
    for (List&lt;String&gt; g : complejos.values()) {
        if (g.size() &lt; 2 || etiquetados.contains(raiz(g.get(0)))) continue;
        Collections.sort(g);
        String rep = g.get(0);
        if (etiquetar(nombreNodo.get(rep), posNodo.get(rep)[0], posNodo.get(rep)[1], 10, false,
                new java.awt.Color(50, 50, 50), ocupados, null, null)) etiquetados.add(raiz(rep));
    }
    for (Recorrido r : datos.red.recorridos()) {
        if (r.sentido != 0 || r.linea.equals("F")) continue;
        for (String n : new String[] {r.nodos[0], r.nodos[r.largo() - 1]}) {
            if (etiquetados.contains(raiz(n))) continue;
            if (etiquetar(nombreNodo.get(n), posNodo.get(n)[0], posNodo.get(n)[1], 10, false,
                    new java.awt.Color(90, 90, 90), ocupados, null, null)) etiquetados.add(raiz(n));
        }
    }
    List&lt;double[]&gt; ocupadosExtra = new ArrayList&lt;&gt;(ocupados);
    for (String n : new TreeSet&lt;&gt;(posNodo.keySet())) {
        if (etiquetados.contains(raiz(n))) continue;
        if (etiquetar(nombreNodo.get(n), posNodo.get(n)[0], posNodo.get(n)[1], 9, false,
                GRIS, ocupadosExtra, lineaDe(n), etiquetasExtra)) etiquetados.add(raiz(n));
    }
    for (com.anylogic.engine.presentation.Shape s : etiquetasExtra) s.setVisible(false);

    for (int i = 0; i &lt; LINEAS_MAPA.length(); i++) andenesDeLinea.add(new ArrayList&lt;&gt;());
    for (Recorrido r : datos.red.recorridos()) {
        for (int i = 0; i &lt; r.largo(); i++) {
            Anden&lt;Pasajero&gt; an = andenes.get(Datos.claveAnden(r, i));
            andenesDeNodo.computeIfAbsent(r.nodos[i], k -&gt; new ArrayList&lt;&gt;()).add(an);
            andenesDeLinea.get(LINEAS_MAPA.indexOf(r.linea)).add(an);
        }
    }

    // formaciones: un cuerpo alargado en el sentido de marcha y una proa blanca
    for (int i = 0; i &lt; trenCuerpo.length; i++) {
        trenBorde[i] = new ShapeLine();
        trenBorde[i].setColor(java.awt.Color.BLACK);
        trenBorde[i].setLineWidth(6);
        trenBorde[i].setVisible(false);
        presentation.add(trenBorde[i]);
        trenCuerpo[i] = new ShapeLine();
        trenCuerpo[i].setLineWidth(3.6);
        trenCuerpo[i].setVisible(false);
        presentation.add(trenCuerpo[i]);
        trenProa[i] = new ShapeOval();
        trenProa[i].setRadius(1.4);
        trenProa[i].setFillColor(java.awt.Color.WHITE);
        trenProa[i].setLineColor(java.awt.Color.BLACK);
        trenProa[i].setLineWidth(1);
        trenProa[i].setVisible(false);
        presentation.add(trenProa[i]);
    }

    // ---- panel izquierdo
    double y = 12;
    texto(X_PANEL, y, 15, true, GRIS_OSCURO, "Red de Subte de Buenos Aires");
    texto(X_PANEL, y + 20, 12, true, escenario.contains("con la Linea F") ? new java.awt.Color(190, 95, 0) : GRIS,
            escenario);
    separador(y + 40);
    relojMapa = texto(X_PANEL, y + 46, 34, true, GRIS_OSCURO, "05:00");
    cuentaMapa = texto(X_PANEL + 118, y + 50, 12, false, GRIS_OSCURO, "en el sistema: 0");
    formacionesMapa = texto(X_PANEL + 118, y + 68, 12, false, GRIS_OSCURO, "formaciones en circulacion: 0");
    promediosMapa = texto(X_PANEL, y + 92, 11, false, GRIS, "viaje medio: --   espera media: --");
    separador(y + 110);

    y = 128;
    texto(X_PANEL, y, 12, true, GRIS_OSCURO, "Que muestran los tramos");
    ShapeRadioButtonGroup rg = new ShapeRadioButtonGroup(this, true, X_PANEL, y + 16, ANCHO_PANEL, 60,
            java.awt.Color.WHITE, GRIS_OSCURO, new java.awt.Font("SansSerif", java.awt.Font.PLAIN, 12), true,
            new String[] {"Lineas y trenes", "Carga de pasajeros ahora (ultimos 15 min)",
                          "Con la Linea F frente a la red actual (referencia)"}) {
        @Override
        public void action() {
            modo = getValue();
            aplicarModo();
        }
    };
    presentation.add(rg);
    ShapeCheckBox cbNombres = new ShapeCheckBox(this, true, X_PANEL, y + 80, ANCHO_PANEL, 18, java.awt.Color.WHITE,
            GRIS_OSCURO, new java.awt.Font("SansSerif", java.awt.Font.PLAIN, 12), "Nombres de todas las estaciones") {
        @Override
        public void action() {
            for (com.anylogic.engine.presentation.Shape s : etiquetasExtra) s.setVisible(isSelected());
        }
    };
    cbNombres.setSelected(false, false);
    presentation.add(cbNombres);
    separador(y + 104);

    y = 240;
    texto(X_PANEL, y, 12, true, GRIS_OSCURO, "Lineas  (tildar para mostrar)");
    for (int i = 0; i &lt; LINEAS_MAPA.length(); i++) {
        final String linea = LINEAS_MAPA.substring(i, i + 1);
        ShapeCheckBox cb = new ShapeCheckBox(this, true, X_PANEL, y + 16 + i * 20, 40, 18, colorLinea(linea),
                java.awt.Color.WHITE, new java.awt.Font("SansSerif", java.awt.Font.BOLD, 12), linea) {
            @Override
            public void action() {
                alternarLinea(linea, isSelected());
            }
        };
        cb.setSelected(true, false);
        presentation.add(cb);
        filaLinea[i] = texto(X_PANEL + 48, y + 18 + i * 20, 11, false, colorLinea(linea).darker());
    }
    separador(y + 160);

    y = 408;
    tituloEstacion = texto(X_PANEL, y, 12, true, GRIS_OSCURO, "Estacion  (hace clic en el mapa)");
    for (int i = 0; i &lt; filaEstacion.length; i++) filaEstacion[i] = texto(X_PANEL, y + 18 + i * 13, 10, false, GRIS_OSCURO);
    separador(y + 128);

    // ---- grafico: pasajeros en el sistema a lo largo del dia (una barra cada 5 min)
    texto(X_GRAF, Y_GRAF - ALTO_GRAF - 16, 12, true, GRIS_OSCURO, "Pasajeros en el sistema  (tope 30.000)");
    ShapeLine eje = new ShapeLine();
    eje.setPos(X_GRAF - 2, Y_GRAF);
    eje.setDx(barra.length * PASO_GRAF + 4);
    eje.setDy(0);
    eje.setColor(GRIS);
    eje.setLineWidth(1);
    presentation.add(eje);
    for (int h : new int[] {5, 8, 12, 16, 20, 24}) {
        texto(X_GRAF + (h - 5) * 12 * PASO_GRAF - 6, Y_GRAF + 3, 10, false, GRIS, h + "h");
    }
    for (int i = 0; i &lt; barra.length; i++) {
        barra[i] = new ShapeLine();
        barra[i].setPos(X_GRAF + i * PASO_GRAF, Y_GRAF);
        barra[i].setDx(0);
        barra[i].setDy(0);
        barra[i].setColor(new java.awt.Color(80, 140, 200));
        barra[i].setLineWidth(PASO_GRAF);
        presentation.add(barra[i]);
    }
    separador(Y_GRAF + 20);

    // ---- comparacion a la hora en curso: simulador de referencia, sin la F y con la F
    y = Y_GRAF + 28;
    tituloComparacion = texto(X_PANEL, y, 12, true, GRIS_OSCURO, "Sin la F  -&gt;  con la F, a esta hora");
    texto(X_PANEL, y + 15, 10, false, GRIS, "referencia, 10 replicas; carga maxima por tramo, pas./h");
    for (int i = 0; i &lt; 7; i++) filaComparacion[i] = texto(X_PANEL + (i % 2) * 150, y + 31 + (i / 2) * 13, 10, false, GRIS_OSCURO);
    filaComparacion[7] = texto(X_PANEL, y + 31 + 4 * 13, 10, false, GRIS_OSCURO);

    // ---- leyenda bajo el mapa, una por modo
    for (int k = 0; k &lt; 3; k++) leyendaModo.add(new ArrayList&lt;&gt;());
    double x0 = 332;
    List&lt;com.anylogic.engine.presentation.Shape&gt; L = leyendaModo.get(0);
    L.add(texto(x0, Y_LEYENDA, 11, true, GRIS_OSCURO, "Formacion, ocupacion:"));
    double x = muestra(x0 + 140, Y_LEYENDA, VERDE, true, "menos del 30 %", L);
    x = muestra(x, Y_LEYENDA, AMBAR, true, "30 a 70 %", L);
    x = muestra(x, Y_LEYENDA, ROJO, true, "mas del 70 %", L);
    L.add(texto(x0, Y_LEYENDA + 18, 11, true, GRIS_OSCURO, "Estacion, esperan:"));
    x = muestra(x0 + 140, Y_LEYENDA + 18, GRIS, false, "menos de 30", L);
    x = muestra(x, Y_LEYENDA + 18, new java.awt.Color(255, 214, 140), true, "30 a 150", L);
    x = muestra(x, Y_LEYENDA + 18, new java.awt.Color(235, 90, 70), true, "mas de 150", L);
    L.add(texto(x + 10, Y_LEYENDA + 18, 11, false, GRIS_OSCURO, "pasillo blanco: combinacion a pie"));

    L = leyendaModo.get(1);
    L.add(texto(x0, Y_LEYENDA, 11, true, GRIS_OSCURO, "Banda por tramo y sentido, a la derecha de la marcha."));
    L.add(texto(x0 + 352, Y_LEYENDA, 11, false, GRIS_OSCURO,
            "ancho = pasajeros por hora en los ultimos 15 min (lleno a " + miles(ESCALA_BANDA) + ")"));
    L.add(texto(x0, Y_LEYENDA + 18, 11, false, GRIS_OSCURO, "color = ocupacion media de los trenes que pasaron:"));
    x = muestra(x0 + 300, Y_LEYENDA + 18, VERDE, true, "&lt; 30 %", L);
    x = muestra(x, Y_LEYENDA + 18, AMBAR, true, "30 a 70 %", L);
    x = muestra(x, Y_LEYENDA + 18, ROJO, true, "&gt; 70 %", L);

    L = leyendaModo.get(2);
    L.add(texto(x0, Y_LEYENDA, 11, true, GRIS_OSCURO,
            "Diferencia de carga por tramo a esta hora, con la F menos sin la F (simulador de referencia, 10 replicas):"));
    x = muestra(x0, Y_LEYENDA + 18, AZUL, true, "menos pasajeros con la F", L);
    x = muestra(x, Y_LEYENDA + 18, ROJO, true, "mas pasajeros con la F", L);
    x = muestra(x, Y_LEYENDA + 18, NARANJA, true, "tramo nuevo de la F", L);
    L.add(texto(x, Y_LEYENDA + 18, 11, false, GRIS_OSCURO, "ancho lleno = " + miles(ESCALA_DIFERENCIA) + " pas./h"));

    aplicarModo();
    actualizarComparacion(5);
}

void actualizarBandas() {
    if (modo == 0) return;
    double t = time();
    int hora = Math.max(0, Math.min(23, (int) (t / 3600)));
    for (Banda b : bandas) {
        if (!lineaVisible[LINEAS_MAPA.indexOf(b.linea)]) continue;
        double ancho = 1;
        java.awt.Color color = GRIS_CLARO;
        if (modo == 1) {
            ArrayDeque&lt;double[]&gt; cola = salidasTramo.get(b.clave);
            double pas = 0;
            int trenes = 0;
            if (cola != null) {
                while (!cola.isEmpty() &amp;&amp; cola.peekFirst()[0] &lt; t - VENTANA_CARGA_S) cola.pollFirst();
                for (double[] s : cola) { pas += s[1]; trenes++; }
            }
            double pasHora = pas * 3600 / VENTANA_CARGA_S;
            if (trenes &gt; 0) {
                ancho = 1 + ANCHO_BANDA_MAX * Math.min(1, pasHora / ESCALA_BANDA);
                color = colorOcupacion(pas / (trenes * Datos.capacidad(b.linea)));
            }
        } else {
            double[] vb = refBase.get(b.clave), vf = refF.get(b.clave);
            double f = vf == null ? Double.NaN : vf[hora], base = vb == null ? Double.NaN : vb[hora];
            if (Double.isNaN(f)) {
                ancho = 1;
            } else if (Double.isNaN(base)) {
                ancho = 1 + ANCHO_BANDA_MAX * Math.min(1, f / ESCALA_BANDA);
                color = NARANJA;
            } else {
                double d = f - base;
                ancho = 1 + ANCHO_BANDA_MAX * Math.min(1, Math.abs(d) / ESCALA_DIFERENCIA);
                color = Math.abs(d) &lt; 150 ? GRIS_CLARO : d &lt; 0 ? AZUL : ROJO;
            }
        }
        b.forma.setLineWidth(ancho);
        b.forma.setLineColor(color);
    }
}

void actualizarEstacion() {
    if (nodoSeleccionado == null) return;
    List&lt;String&gt; grupo = new ArrayList&lt;&gt;();
    for (String n : posNodo.keySet()) if (raiz(n).equals(raiz(nodoSeleccionado))) grupo.add(n);
    Collections.sort(grupo);
    StringBuilder lineas = new StringBuilder();
    for (String n : grupo) lineas.append(lineaDe(n));
    tituloEstacion.setText(nombreNodo.get(nodoSeleccionado) + "  [" + lineas + "]");
    int fila = 0;
    for (String n : grupo) {
        for (Anden&lt;Pasajero&gt; an : andenesDeNodo.get(n)) {
            if (an.indice + 1 &gt;= an.recorrido.largo() || fila &gt;= filaEstacion.length) continue;
            String hacia = nombreNodo.get(an.recorrido.nodos[an.recorrido.largo() - 1]);
            if (hacia.length() &gt; 16) hacia = hacia.substring(0, 15) + ".";
            filaEstacion[fila].setColor(colorLinea(an.recorrido.linea).darker());
            filaEstacion[fila].setText(String.format("%s hacia %-16s esperan %4d   max. %4d   no entraron %d",
                    an.recorrido.linea, hacia, an.esperando(), an.maximo(), an.quedaronAbajo()));
            fila++;
        }
    }
    for (; fila &lt; filaEstacion.length; fila++) filaEstacion[fila].setText("");
}

void actualizarComparacion(int hora) {
    hora = Math.max(0, Math.min(23, hora));
    double[] maxBase = new double[7], maxF = new double[7];
    for (Map.Entry&lt;String, double[]&gt; e : refBase.entrySet()) {
        int li = LINEAS_MAPA.indexOf(e.getKey().substring(0, 1));
        maxBase[li] = Math.max(maxBase[li], e.getValue()[hora]);
    }
    for (Map.Entry&lt;String, double[]&gt; e : refF.entrySet()) {
        int li = LINEAS_MAPA.indexOf(e.getKey().substring(0, 1));
        maxF[li] = Math.max(maxF[li], e.getValue()[hora]);
    }
    tituloComparacion.setText(String.format("Sin la F  -&gt;  con la F, de %d a %d h", hora, hora + 1));
    for (int li = 0; li &lt; 7; li++) {
        String L = LINEAS_MAPA.substring(li, li + 1);
        String fila;
        if (maxF[li] == 0 &amp;&amp; maxBase[li] == 0) fila = L + "   sin datos";
        else if (maxBase[li] == 0) fila = L + "   --  -&gt;  " + miles(maxF[li]) + "  (nueva)";
        else fila = String.format("%s   %s -&gt; %s  (%+.0f %%)", L, miles(maxBase[li]), miles(maxF[li]),
                100 * (maxF[li] / maxBase[li] - 1));
        filaComparacion[li].setText(fila);
        filaComparacion[li].setColor(colorLinea(L).darker());
    }
    double[] vb = refHoraBase[hora], vf = refHoraF[hora];
    filaComparacion[7].setText(vb == null || vf == null ? "" : String.format(
            "viaje medio %s -&gt; %s s      espera media %s -&gt; %s s", miles(vb[0]), miles(vf[0]), miles(vb[1]), miles(vf[1])));
}

void actualizarMapa() {
    double t = time();
    for (Formacion f : formaciones) {
        int k = f.getIndex();
        int li = LINEAS_MAPA.indexOf(f.recorrido == null ? "A" : f.recorrido.linea);
        if (!f.activa || !lineaVisible[li]) {
            trenBorde[k].setVisible(false);
            trenCuerpo[k].setVisible(false);
            trenProa[k].setVisible(false);
            continue;
        }
        double[] q;
        if (f.enMarcha &amp;&amp; f.indice + 1 &lt; f.recorrido.largo()) {
            double u = (t - f.tSalida) / f.recorrido.tramo[f.indice];
            q = sobreTrazo(trazoDe(f.recorrido.nodos[f.indice], f.recorrido.nodos[f.indice + 1]), u);
        } else if (f.indice + 1 &lt; f.recorrido.largo()) {
            q = sobreTrazo(trazoDe(f.recorrido.nodos[f.indice], f.recorrido.nodos[f.indice + 1]), 0);
        } else {
            q = sobreTrazo(trazoDe(f.recorrido.nodos[f.indice - 1], f.recorrido.nodos[f.indice]), 1);
        }
        double largo = Datos.COCHES.get(f.recorrido.linea) * 2.3;
        double x0 = q[0] - q[2] * largo / 2, y0 = q[1] - q[3] * largo / 2;
        java.awt.Color c = colorOcupacion((double) f.carga.aBordo() / Datos.capacidad(f.recorrido.linea));
        trenBorde[k].setPos(x0, y0);
        trenBorde[k].setDx(q[2] * largo);
        trenBorde[k].setDy(q[3] * largo);
        trenCuerpo[k].setPos(x0, y0);
        trenCuerpo[k].setDx(q[2] * largo);
        trenCuerpo[k].setDy(q[3] * largo);
        trenCuerpo[k].setColor(c);
        trenProa[k].setPos(q[0] + q[2] * largo / 2, q[1] + q[3] * largo / 2);
        trenBorde[k].setVisible(true);
        trenCuerpo[k].setVisible(true);
        trenProa[k].setVisible(true);
    }
    if (cuadroMapa++ % 8 != 0) return;

    for (Map.Entry&lt;String, ShapeOval&gt; e : marcaNodo.entrySet()) {
        int n = 0;
        for (Anden&lt;Pasajero&gt; an : andenesDeNodo.get(e.getKey())) n += an.esperando();
        e.getValue().setRadius(4 + Math.min(10, Math.sqrt(n) * 0.35));
        e.getValue().setFillColor(n &lt; 30 ? java.awt.Color.WHITE
                : n &lt; 150 ? new java.awt.Color(255, 214, 140) : new java.awt.Color(235, 90, 70));
    }
    int enSistema = enAnden.size() + aBordo.size() + caminata.size();
    int hora = (int) (t / 3600);
    relojMapa.setText(String.format("%02d:%02d", hora, (int) (t % 3600 / 60)));
    cuentaMapa.setText("en el sistema: " + miles(enSistema));
    formacionesMapa.setText("formaciones en circulacion: " + (formaciones.size() - formacionesLibres.size()));
    promediosMapa.setText(arribados == 0 ? "viaje medio: --   espera media: --"
            : "viaje medio: " + miles(sumaTiempoViaje / arribados) + " s   espera media: "
              + miles(sumaEspera / arribados) + " s   (" + miles(arribados) + " viajes)");

    int[] trenes = new int[7];
    double[] sumaOc = new double[7], maxOc = new double[7];
    for (Formacion f : formaciones) {
        if (!f.activa) continue;
        int li = LINEAS_MAPA.indexOf(f.recorrido.linea);
        double u = (double) f.carga.aBordo() / Datos.capacidad(f.recorrido.linea);
        trenes[li]++;
        sumaOc[li] += u;
        maxOc[li] = Math.max(maxOc[li], u);
    }
    for (int i = 0; i &lt; 7; i++) {
        int esperan = 0;
        for (Anden&lt;Pasajero&gt; an : andenesDeLinea.get(i)) esperan += an.esperando();
        filaLinea[i].setText(String.format("%2d trenes   ocup. %3.0f %% (max. %3.0f %%)   esperan %s",
                trenes[i], trenes[i] == 0 ? 0 : 100 * sumaOc[i] / trenes[i], 100 * maxOc[i], miles(esperan)));
    }
    int muestra = (int) ((t - 5 * 3600) / 300);
    if (muestra &gt;= 0 &amp;&amp; muestra &lt; barra.length &amp;&amp; muestra &gt; ultimaMuestra) {
        ultimaMuestra = muestra;
        barra[muestra].setDy(-Math.min(1.0, enSistema / 30000.0) * ALTO_GRAF);
    }
    if (hora != horaComparacion) {
        horaComparacion = hora;
        actualizarComparacion(hora);
    }
    actualizarBandas();
    actualizarEstacion();
}
int horaComparacion = -1;

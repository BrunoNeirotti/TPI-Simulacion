		<RunConfiguration ActiveObjectClassId="1791253830826">
			<Id>1791253830837</Id>
			<Name>RunConfiguration</Name>
			<MaximumMemory>2048</MaximumMemory>
			<ModelTimeProperties>
				<StopOption>Stop at specified time</StopOption>

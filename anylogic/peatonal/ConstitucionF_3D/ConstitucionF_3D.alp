  java.util.Arrays.sort(v);
  tr = " | tiempo entrada-&gt;abordaje (s): n=" + v.length + " media " + (int) (sm / v.length) + " p50 " + (int) v[v.length / 2] + " p90 " + (int) v[(int) (v.length * 0.9)] + " p95 " + (int) v[(int) (v.length * 0.95)] + " max " + (int) v[v.length - 1];
}
traceln("t=" + (int) time(SECOND) + " s | entraron: calle " + entraCalle.out.count() + ", Roca " + entraRoca.out.count() + ", C " + entraDesdeC.out.count() + " | bajaron del tren: norte " + bajanTrenNorte.out.count() + ", sur " + bajanTrenSur.out.count() + " | abordaron " + abordan.in.count() + " | esperando ahora: norte " + esperaNorte.size() + ", sur " + esperaSur.size() + " (max antes de un tren: " + maxEsperaN + " / " + maxEsperaS + ")" + " | salieron: calle " + salenCalle.in.count() + ", Roca " + salenRoca.in.count() + ", C " + salenAC.in.count() + tr + " | en escaleras ahora: " + e + " | rendimiento (pas/h, ult. 5 min): " + th);</Action>

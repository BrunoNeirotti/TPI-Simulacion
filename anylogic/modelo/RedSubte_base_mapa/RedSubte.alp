				<RandomNumberGenerationType>fixedSeed</RandomNumberGenerationType>
				<CustomGeneratorCode>new Random()</CustomGeneratorCode>
				<AfterSimulationRunCode>long enSistema = root.enAnden.size() + root.aBordo.size() + root.caminata.size();
traceln("Ingresados " + root.ingresados + ", arribados " + root.arribados
        + ", en el sistema " + enSistema + ", descartados " + root.descartados);
traceln("Conservacion: " + (root.ingresados == root.arribados + enSistema ? "OK" : "FALLA"));
if (root.arribados &gt; 0) {
    traceln("Tiempo medio de viaje " + Math.round(root.sumaTiempoViaje / root.arribados)
            + " s, espera media " + Math.round(root.sumaEspera / root.arribados) + " s");
}
traceln("Ascensos por viaje " + String.format(java.util.Locale.ROOT, "%.3f", (double) root.ascensos / root.ingresados)
        + ", no entran " + root.noEntran() + ", max pasajeros vivos " + root.maxVivos
        + ", max formaciones " + root.maxFormaciones);
traceln("Separacion por tramo: " + root.tramos.retenciones + " retenciones, " + Math.round(root.tramos.segundosRetenidos)
        + " s; detencion media " + String.format(java.util.Locale.ROOT, "%.2f", root.paradas == 0 ? 0 : root.sumaDetencion / root.paradas) + " s");</AfterSimulationRunCode>

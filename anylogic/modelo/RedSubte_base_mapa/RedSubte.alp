			<ActiveObjectClass>
				<Id>1791260000106</Id>
				<Name>Formacion</Name>
				<AdditionalClassCode>Recorrido recorrido;
int indice;              // estacion donde esta (0 = cabecera)
boolean recienSale;      // primera parada: no hay detencion
double dwell;            // duracion de la detencion en la estacion actual (D13)
double espera;           // espera por tramo ocupado antes de salir (D15)
boolean activa;          // en circulacion (para la capa visual)
boolean enMarcha;        // entre dos estaciones
double tSalida;          // cuando salio de la ultima estacion
Carga&lt;Pasajero&gt; carga;

void iniciar(Recorrido r, int desde, int capacidad) {
    recorrido = r;
    indice = desde;
    recienSale = true;
    activa = true;
    enMarcha = false;
    carga = new Carga&lt;Pasajero&gt;(r.largo(), capacidad);
}</AdditionalClassCode>
